{
  "id": "AlertsEvery15",
  "name": "Budget, large-payment and renewal alerts → Telegram",
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Dubai"
  },
  "nodes": [
    {
      "id": "n1",
      "name": "Every 15 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      }
    },
    {
      "id": "n2",
      "name": "Any alerts due?",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "http://personal-logger:3000/api/alerts",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "LoggerIngest01",
          "name": "Logger ingest secret"
        }
      }
    },
    {
      "id": "n3",
      "name": "Something to send?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ Number($json.count) > 0 }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "n4",
      "name": "Send alert",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        720,
        -60
      ],
      "parameters": {
        "chatId": "8852089040",
        "text": "={{ $json.text }}",
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "credentials": {
        "telegramApi": {
          "id": "UKOvxVufcMgOxUv5",
          "name": "Telegram account"
        }
      }
    }
  ],
  "connections": {
    "Every 15 minutes": {
      "main": [
        [
          {
            "node": "Any alerts due?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Any alerts due?": {
      "main": [
        [
          {
            "node": "Something to send?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Something to send?": {
      "main": [
        [
          {
            "node": "Send alert",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    }
  }
}