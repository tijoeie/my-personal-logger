{
  "id": "MonthEndReport01",
  "name": "Month-end report → Telegram",
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Dubai"
  },
  "nodes": [
    {
      "id": "n1",
      "name": "Every day 10am",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 10 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "n2",
      "name": "Get report if due",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "http://personal-logger:3000/api/report?due=1",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "response": {
            "response": {
              "responseFormat": "autodetect",
              "outputPropertyName": "data"
            }
          }
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "LoggerIngest01",
          "name": "Logger ingest secret"
        }
      }
    },
    {
      "id": "n3",
      "name": "Is a PDF?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ Object.keys($binary || {}).length > 0 }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "n4",
      "name": "Send PDF",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        720,
        -60
      ],
      "parameters": {
        "operation": "sendDocument",
        "chatId": "8852089040",
        "binaryData": true,
        "binaryPropertyName": "data",
        "additionalFields": {
          "caption": "Month-end report for the salary period that just ended",
          "appendAttribution": false,
          "fileName": "month-end-report.pdf"
        }
      },
      "credentials": {
        "telegramApi": {
          "id": "UKOvxVufcMgOxUv5",
          "name": "Telegram account"
        }
      }
    },
    {
      "id": "n5",
      "name": "Send me the report now",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        200
      ],
      "webhookId": "b6b39e50a8395755",
      "parameters": {
        "path": "report-now-9f7f7034c715",
        "httpMethod": "GET",
        "responseMode": "onReceived",
        "options": {}
      }
    },
    {
      "id": "n6",
      "name": "Get report now",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        200
      ],
      "parameters": {
        "method": "GET",
        "url": "http://personal-logger:3000/api/report?due=1&force=1",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file",
              "outputPropertyName": "data"
            }
          }
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "LoggerIngest01",
          "name": "Logger ingest secret"
        }
      }
    }
  ],
  "connections": {
    "Every day 10am": {
      "main": [
        [
          {
            "node": "Get report if due",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get report if due": {
      "main": [
        [
          {
            "node": "Is a PDF?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Is a PDF?": {
      "main": [
        [
          {
            "node": "Send PDF",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    },
    "Send me the report now": {
      "main": [
        [
          {
            "node": "Get report now",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get report now": {
      "main": [
        [
          {
            "node": "Send PDF",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}