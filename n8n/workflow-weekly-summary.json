{
  "id": "WeeklySummary01",
  "name": "Weekly summary → Telegram",
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Dubai"
  },
  "nodes": [
    {
      "id": "n1",
      "name": "Every Sunday 6pm",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 18 * * 0"
            }
          ]
        }
      }
    },
    {
      "id": "n2",
      "name": "Get summary",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "http://personal-logger:3000/api/summary",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "LoggerIngest01",
          "name": "Logger ingest secret"
        }
      }
    },
    {
      "id": "n3",
      "name": "Send to Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "chatId": "8852089040",
        "text": "={{ $json.text }}",
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "credentials": {
        "telegramApi": {
          "id": "UKOvxVufcMgOxUv5",
          "name": "Telegram account"
        }
      }
    }
  ],
  "connections": {
    "Every Sunday 6pm": {
      "main": [
        [
          {
            "node": "Get summary",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get summary": {
      "main": [
        [
          {
            "node": "Send to Telegram",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}